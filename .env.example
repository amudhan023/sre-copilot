KAFKA_BOOTSTRAP=localhost:29092
KAFKA_INCIDENT_TOPIC=incidents
REDIS_URL=redis://localhost:6379/0
RECEIVER_PORT=8080
RECEIVER_TOKEN=
DEDUP_TTL_SECONDS=14400
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_STRATEGY=fallback
# Ordered fallback chain. Valid names: gemini, groq, claude_code, file.
LLM_PROVIDERS=gemini,groq
CLAUDE_CODE_MODEL=
CLAUDE_CODE_TIMEOUT_SECONDS=180
CLAUDE_CODE_MAX_TURNS=1
CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192
CLAUDE_CODE_PERMISSION_MODE=default
CLAUDE_CODE_WORKING_DIRECTORY=

# File-backed LLM transport (docs/file-llm-transport.md). Set LLM_TRANSPORT=file
# to answer every LLM call from llm_calls/ instead of any provider API.
LLM_TRANSPORT=api
LLM_CALLS_DIR=
LLM_FILE_TIMEOUT=900
LLM_FILE_POLL_INTERVAL=2
LLM_FILE_VALIDATION_ATTEMPTS=3

# observe-mcp-server (the agent's logs/traces/metrics/dashboards/code tools).
# It runs as a subprocess and inherits this environment. Replace UBUNTU_HOST
# with the observability machine's address. Full list and defaults:
# ../observe-mcp-server/.env.example
OPENSEARCH_URL=http://UBUNTU_HOST:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
PROMETHEUS_URL=http://UBUNTU_HOST:9090
PROMETHEUS_SERVICE_LABEL=service
GRAFANA_URL=http://UBUNTU_HOST:3000
# Service account token (Viewer role), or username/password.
GRAFANA_TOKEN=
GITHUB_TOKEN=
# Comma-separated owner/name allowlist; empty means any repo the token can read.
GITHUB_REPOS=
